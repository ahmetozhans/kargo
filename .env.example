# Browser-visible; restrict to Maps JavaScript API and your exact website origins.
GOOGLE_MAPS_BROWSER_KEY=
# Server-only; restrict to Geocoding API, Places API (New), Routes API.
GOOGLE_MAPS_SERVER_KEY=
# Optional: set to 1 only if you explicitly permit paid Pro route optimization.
ENABLE_GOOGLE_OPTIMIZATION=0
# Application-side daily request ceilings per process (also configure Google Cloud quotas).
DAILY_GEOCODE_LIMIT=100
DAILY_PLACES_LIMIT=100
DAILY_ROUTES_LIMIT=30
DAILY_OPTIMIZE_LIMIT=5
